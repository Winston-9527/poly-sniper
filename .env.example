# 复制为 .env 后按需修改。所有变量都有默认值，除 Telegram 与 RPC 外都可留空。

# ---- Telegram 推送 ----
# TELEGRAM_ENABLED 默认 0：新链路（PIPELINE=ledger）默认只记录不发送。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=0

# ---- 链上 RPC ----
# 实测验过的可用端点（2026-10-09）：publicnode 可用但 eth_getLogs 只支持近端区块；
# polygon.drpc.org 可查更老区间，但可能返回 zstd 压缩体（客户端已显式请求 identity）。
# 已停用/不可用：polygon-rpc.com（tenant disabled）、polygon.llamarpc.com、1rpc.io/matic。
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# ---- 代理（本机直连 Polymarket / Telegram 会超时）----
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897

# ============ P1 新链路（PIPELINE=ledger）============

# 运行哪条链路：sentinel（默认，现有异动链路）| ledger（新的持续采集 + 持仓账本链路）
PIPELINE=sentinel
# 影子模式：1 = 只记录不向 Telegram 发送（状态机照常走，message_id 记为 shadow）
SHADOW_MODE=1

# 数据库与备份
DB_PATH=./data/poly-sniper.sqlite
BACKUP_DIR=./data/backups
BACKUP_EVERY_CYCLES=96
CYCLE_INTERVAL_SECONDS=300

# 请求预算（一轮内所有来源共享；耗尽则记缺口，不宣称完整覆盖）
REQUESTS_PER_CYCLE=220
COLLECT_CONCURRENCY=3
REQUEST_SPACING_MS=120
WALLETS_PER_CYCLE=60
NEW_CANDIDATES_PER_CYCLE=40
ACTIVITY_PAGES_PER_PULL=2
BACKFILL_MAX_PAGES=8
BACKFILL_ENABLED=0

# 候选发现
SIGNIFICANT_TRADE_NOTIONAL=5000     # 单边显著成交下限（USDC）
SIGNIFICANT_TRADE_SUM=25000         # 双边累计下限（USDC）
TRADE_WINDOW_HOURS=72
HOLDER_TOP_N=20                     # 每个 token 取前 N 持仓者
HOLDER_MIN_SIZE=10000               # 重点持有人的最低份数

# 行为与优先级（都是可配置假设，阴影运行后再调；RULES_VERSION=p1-rules-1）
REDUCE_PCT_THRESHOLD=0.15           # 减仓比例阈值（相对自身持仓）
RELATIVE_SIZE_MULTIPLIER=3          # 相对历史典型规模的倍数阈值
ABSOLUTE_NOTIONAL_FLOOR=10000       # 绝对规模下限（低于它不进高优先级，避免微小仓位刷屏）
POSITION_OPEN_HIGH_MULTIPLIER=3     # 新出现持仓达到「下限 × 该倍数」判高优先级
REACTIVATION_HOURS=720              # 沉寂后恢复的静默时长
INCREMENTAL_OVERLAP_HOURS=3         # 增量重叠读取窗口（处理延迟数据）
ALERT_COOLDOWN_MINUTES=30           # 同一持仓过程的报警冷却
COLLECT_INTERVAL_MANUAL_MIN=15
COLLECT_INTERVAL_HOLDER_MIN=60
COLLECT_INTERVAL_LOWFREQ_MIN=720
BASELINE_WINDOWS_DAYS=30,90

# 推送限速与重试（限速溢出会合并成摘要，不丢消息）
MAX_ALERTS_PER_MIN=6
PUSH_MAX_ATTEMPTS=5

LOG_LEVEL=info

# ============ 旧链路（PIPELINE=sentinel）的配置 ============
MIN_LIQUIDITY=25000
MIN_VOLUME_24H=1000
POLL_PAGES_PER_CYCLE=5
MAX_MARKET_PAGES=700
CANDIDATE_TOP_K=25
PROFILE_CONCURRENCY=4
SCORE_THRESHOLD=60
FUNDING_SCAN_CHUNKS=0
FUNDER_DENYLIST=
WALLET_CACHE_PATH=./data/wallet-cache.json
