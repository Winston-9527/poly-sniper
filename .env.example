RPC_URL=https://polygon-rpc.com
ALCHEMY_API_KEY=
ALCHEMY_RPC_URL=
# ANKR_API_KEY 已弃用

# 代理配置（可选）
HTTPS_PROXY=
HTTP_PROXY=

# MCP / Workflow
LANGGRAPH_WEBHOOK_URL=http://127.0.0.1:8788/webhook
MCP_AUTO_START=false
MCP_PORT=8788

# Profiler 服务（真实钱包画像）
PROFILER_API_URL=http://127.0.0.1:8793/profile
PROFILER_AUTO_START=false
PROFILER_PORT=8793

# LLM 配置（生产必填）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# 测试开关（本地验证用）
WORKFLOW_USE_MOCK_LLM=true
WORKFLOW_USE_MOCK_WALLETS=true

# 端到端真实市场参数（可选）
