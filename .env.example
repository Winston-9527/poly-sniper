# 复制为 .env 后按需修改。所有变量都有默认值，除 Telegram 与 RPC 外都可留空。

# ---- Telegram 推送（必填，否则不推送）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 链上 RPC（polygon-rpc.com 已停用：403 tenant disabled）----
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# ---- 代理（本机直连 Polymarket / Telegram 会超时）----
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897

# ---- 市场过滤 / 监控面 ----
MIN_LIQUIDITY=25000
MIN_VOLUME_24H=1000
MAX_ALERTS_PER_MIN=6
POLL_PAGES_PER_CYCLE=5
MAX_MARKET_PAGES=700

# ---- 候选池 / 画像 ----
TRADE_WINDOW_HOURS=72
TRADE_SCAN_PAGES=4
CANDIDATE_TOP_K=25
PROFILE_CONCURRENCY=4
SCORE_THRESHOLD=60
FUNDING_SCAN_CHUNKS=0
FUNDER_DENYLIST=
WALLET_CACHE_PATH=./data/wallet-cache.json
