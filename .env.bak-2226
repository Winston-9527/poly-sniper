# ===== 代理配置（本机必需品）=====
# 本机直连 Polymarket / Telegram 均超时，必须走本地代理
# 探测到本机可用代理端口: 127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
https_proxy=http://127.0.0.1:7897
http_proxy=http://127.0.0.1:7897

# ===== P1 新链路（影子运行）配置 =====
PIPELINE=sentinel
SHADOW_MODE=1
DB_PATH=./data/poly-sniper.sqlite
BACKUP_DIR=./data/backups
REQUESTS_PER_CYCLE=320
WALLETS_PER_CYCLE=10
NEW_CANDIDATES_PER_CYCLE=40
ACTIVITY_PAGES_PER_PULL=2
INCREMENTAL_OVERLAP_HOURS=3
